// The registrar's records. Personal data such as email addresses lives here and never on-chain.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A one-time code sent to an email address, to register for one election.
model EmailCode {
  id        Int      @id @default(autoincrement())
  /// Checksummed address of the election.
  election  String
  /// Lower case.
  email     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([election, email])
}

/// An accepted registration: one per email address and one per wallet in each election. It never
/// moves to another wallet, so that its receipt stays evidence of what the registrar accepted.
model Registration {
  id               Int      @id @default(autoincrement())
  election         String
  email            String
  /// Checksummed address of the voter's wallet, which is their entry on the voter list.
  voter            String
  /// The voter's EIP-712 signature over their address and email.
  voterSignature   String
  /// The registrar's EIP-712 signature over the voter's address and `issuedAt` (FR2).
  receiptSignature String
  issuedAt         DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([election, email])
  @@unique([election, voter])
}

/// The voter list of an election, recorded when the registrar starts publishing it. From then on
/// the election takes no more registrations, so retrying a failed publication builds the same list.
model VoterListPublication {
  election  String   @id
  root      String
  count     Int
  /// Empty until the list has been added to IPFS.
  cid       String   @default("")
  /// The `publishVoterList` transaction, recorded as soon as it is sent.
  txHash    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------------------------
// The indexer's copy of the chain. Everything below is public and can be rebuilt from the chain's
// events at any time; the chain stays the source of truth.
// ---------------------------------------------------------------------------------------------

/// An election the factory created, as of the last block the indexer read.
model Election {
  address           String      @id
  authority         String
  registrar         String
  title             String      @default("")
  metadataCid       String      @default("")
  /// Unix seconds.
  registrationStart BigInt      @default(0)
  registrationEnd   BigInt      @default(0)
  votingStart       BigInt      @default(0)
  votingEnd         BigInt      @default(0)
  phase             Int         @default(0)
  voterRoot         String?
  voterCount        Int?
  voterListCid      String?
  /// Set by `Finalized`.
  finalTally        Int[]
  winners           Int[]
  createdAtBlock    BigInt
  createdTxHash     String
  candidates        Candidate[]
  ballots           Ballot[]
}

model Candidate {
  electionAddress String
  index           Int
  name            String
  manifestoCid    String
  election        Election @relation(fields: [electionAddress], references: [address], onDelete: Cascade)

  @@id([electionAddress, index])
}

/// One `VoteCast` event: a ballot the election accepted.
model Ballot {
  id              Int      @id @default(autoincrement())
  electionAddress String
  /// The voter's address in tier 2, the nullifier in tier 3.
  key             String
  candidate       Int
  blockNumber     BigInt
  /// Unix seconds.
  timestamp       BigInt
  txHash          String
  logIndex        Int
  election        Election @relation(fields: [electionAddress], references: [address], onDelete: Cascade)

  @@unique([txHash, logIndex])
  @@index([electionAddress])
}

/// The last block the indexer has read on each chain.
model IndexerCursor {
  chainId     Int      @id
  /// Hash of the chain's first block. A restarted Anvil node is a new chain with a new one.
  genesisHash String   @default("")
  block       BigInt
  /// Hash of `block`, to notice when the chain has replaced it.
  blockHash   String   @default("")
  updatedAt   DateTime @updatedAt
}
