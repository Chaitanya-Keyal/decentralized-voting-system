{
  "name": "@dvote/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "prisma generate && pnpm run \"/^dev:/\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:indexer": "tsx watch src/indexer/main.ts",
    "start": "tsx src/server.ts",
    "indexer": "tsx src/indexer/main.ts",
    "test": "prisma generate && vitest run",
    "typecheck": "prisma generate && tsc --noEmit"
  },
  "dependencies": {
    "@dvote/shared": "workspace:*",
    "@fastify/cors": "^11.3.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "fastify": "^5.12.7",
    "nodemailer": "^10.2.1",
    "pino": "^10.4.0",
    "viem": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
