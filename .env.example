# Copy to .env and fill in. Never commit .env.

# Local services (docker compose up -d)
DATABASE_URL=postgresql://dvote:dvote@localhost:5433/dvote
REDIS_URL=redis://localhost:6380
IPFS_API_URL=http://127.0.0.1:5001

# The chain the API uses: a local Anvil node by default
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
SEPOLIA_RPC_URL=

# The registrar's account. On Anvil, an account the node unlocks: this is Anvil's second default
# account. On a testnet, leave REGISTRAR_ADDRESS empty and set REGISTRAR_PRIVATE_KEY.
REGISTRAR_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
REGISTRAR_PRIVATE_KEY=

# Comma-separated authorities whose elections the registrar serves. Empty serves any election
# that names this registrar, which suits a local chain but not a public one.
AUTHORITIES=

# Registration codes. Locally they go to Mailpit (http://127.0.0.1:8025). On Anvil only, an empty
# SMTP_URL makes the API log each code instead; any other chain requires it.
EMAIL_DOMAIN=hyderabad.bits-pilani.ac.in
SMTP_URL=smtp://127.0.0.1:1025

# Testnet keys (throwaway keys only, never a wallet that holds real funds)
DEPLOYER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=

# IPFS pinning service
PINATA_JWT=
