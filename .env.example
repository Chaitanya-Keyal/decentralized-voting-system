# Copy to .env and fill in. Never commit .env.

# Local services (docker compose up -d)
DATABASE_URL=postgresql://dvote:dvote@localhost:5433/dvote
REDIS_URL=redis://localhost:6380

# Chain
ANVIL_RPC_URL=http://127.0.0.1:8545
SEPOLIA_RPC_URL=

# Keys (use throwaway keys, never a wallet that holds real funds)
DEPLOYER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=
REGISTRAR_PRIVATE_KEY=

# IPFS pinning
PINATA_JWT=
