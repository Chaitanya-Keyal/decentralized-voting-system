{
  "name": "dvote",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @dvote/web --filter @dvote/api dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm --filter @dvote/web typegen && eslint .",
    "lint:fix": "pnpm --filter @dvote/web typegen && eslint . --fix",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "e2e": "pnpm --filter @dvote/e2e e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:contracts": "forge build --root contracts",
    "test:contracts": "forge test --root contracts",
    "format:contracts": "forge fmt --root contracts",
    "lint:contracts": "forge lint --root contracts --deny warnings",
    "gas:contracts": "cd contracts && GAS_SNAPSHOT=true FOUNDRY_PROFILE=gas forge test --match-contract GasSnapshot",
    "deploy:local": "cd contracts && forge script script/Deploy.s.sol --rpc-url http://127.0.0.1:8545 --broadcast --unlocked --sender 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266",
    "deploy:sepolia": "cd contracts && forge script script/Deploy.s.sol --rpc-url \"$SEPOLIA_RPC_URL\" --private-key \"$DEPLOYER_PRIVATE_KEY\" --broadcast --verify --verifier sourcify --slow",
    "db:migrate": "pnpm --filter @dvote/api exec prisma migrate deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.0"
  }
}
